# Crie um projeto no Supabase e copie estes valores em .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_chave_publicavel

# Somente no servidor. Nunca use o prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SECRET_KEY=sua_chave_secreta_sb_secret
